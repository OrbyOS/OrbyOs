# Claves del PROYECTO (no las de cada cliente: el cliente no conecta nada).
# Pega cada clave justo detrás del signo =, sin espacios ni comillas.
# Este archivo no se comparte ni se pega en ningún chat.

# Todo esto también se puede pegar desde la app: Administración → Claves y ajustes.

# Cómo usa Claude la app: api (clave de console.anthropic.com) o claude_code (tu plan Pro/Max con Claude Code)
RADAR_MOTOR=api
# Con el motor claude_code: el token de `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Claude (con el motor api)
ANTHROPIC_API_KEY=
# ID del workspace de Anthropic (empieza por wrkspc_). Solo hace falta si la clave empieza por sk-ant-usr
ANTHROPIC_WORKSPACE_ID=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Apify: anuncios de Meta, reels de Instagram, TikTok, LinkedIn y el perfil público del propio negocio
APIFY_TOKEN=

# Biblioteca de anuncios de Meta, API oficial (alternativa a Apify)
META_AD_LIBRARY_TOKEN=

# Cuentas
# Correos que entran como administradores, separados por comas (el primer usuario que se registra también lo es)
ADMIN_EMAILS=
# Pon 1 cuando la app se sirva por https (en la nube)
RADAR_COOKIE_SEGURA=0

# Opcionales
# APP_NOMBRE=Radar                       el nombre que sale en toda la app
# RADAR_IDEAS=0                          1 = además de mostrar e interpretar, propone ideas y guiones
# RADAR_VEGA_DIA=80                      preguntas a Vega por usuario y día
# RADAR_EDITOR_PUBLICO=0                1 = enciende el editor de reels que se vende aparte (/editor y el registro abierto)
# RADAR_PLAN_INICIAL=prueba              plan de las cuentas nuevas de negocio
# RADAR_PLAN_INICIAL_AGENCIA=prueba_agencia  plan de las cuentas nuevas de agencia
# RADAR_PLAN_INICIAL_EDITOR=editor_prueba    plan de las cuentas nuevas del editor de reels
# RADAR_CALENDARIO_URL=                  enlace para reservar la llamada de onboarding (Calendly, Cal.com…)
# RADAR_WHISPER=small                    modelo de transcripción (small, medium…)
# RADAR_MAX_SEGUNDOS=420                 duración máxima del vídeo en bruto
# RADAR_MAX_MB=1500                      tamaño máximo del vídeo en bruto
# RADAR_DATA_DIR=                        carpeta de datos (por defecto, data/)
# APIFY_ADS_ACTOR=valev-lab~facebook-ads-library
# APIFY_IG_ACTOR=apify~instagram-reel-scraper
# APIFY_PERFIL_ACTOR=apify~instagram-profile-scraper
# APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
# APIFY_LINKEDIN_ACTOR=harvestapi~linkedin-profile-posts
# RADAR_MODEL=claude-opus-5-5
# RADAR_PAIS=ES
# META_GRAPH_VERSION=v23.0

# Equipo de agentes
# ZERNIO_API_KEY=                        publicar, DMs y métricas (cada negocio puede poner la suya en Publicación)
# RADAR_URL_PUBLICA=                     la dirección https de la app, para que las guías se abran desde un DM
# RADAR_PRESUPUESTO_APIFY=15             $ de Apify al mes por negocio
# RADAR_PRESUPUESTO_CLAUDE=40            $ de Claude al mes por negocio (el piloto automático se para al llegar)
# RADAR_CUENTAS_POR_ESCANEO=6            cuentas de la competencia en cada escaneo
